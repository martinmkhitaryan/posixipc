# CPython allocator and runtime noise when the extension is loaded under ASan.
# Run pytest with PYTHONMALLOC=malloc and this file in ASAN_OPTIONS=suppressions=...

interceptor_via_fun:pymalloc_alloc
interceptor_via_fun:_PyObject_Malloc
interceptor_via_fun:PyObject_Malloc
interceptor_via_fun:_PyObject_GC_New
interceptor_via_fun:PyType_GenericAlloc
leak:libpython
leak:_PyObject_GC_Alloc
leak:PyThread_allocate_lock
