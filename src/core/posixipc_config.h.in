#ifndef POSIXIPC_CONFIG_H
#define POSIXIPC_CONFIG_H

#include <stdatomic.h>
#include <stddef.h>
#include <pthread.h>
#include <semaphore.h>

#define POSIXIPC_CACHELINE_BYTES @POSIXIPC_CACHELINE_BYTES@
#define POSIXIPC_LIBC_FAMILY @POSIXIPC_LIBC_FAMILY@
#define POSIXIPC_ABI_TAG_SEED @POSIXIPC_ABI_TAG_SEED@ul

#define POSIXIPC_SIZEOF_PTHREAD_MUTEX_T @POSIXIPC_SIZEOF_PTHREAD_MUTEX_T@
#define POSIXIPC_SIZEOF_PTHREAD_RWLOCK_T @POSIXIPC_SIZEOF_PTHREAD_RWLOCK_T@
#define POSIXIPC_SIZEOF_PTHREAD_COND_T @POSIXIPC_SIZEOF_PTHREAD_COND_T@
#define POSIXIPC_SIZEOF_PTHREAD_BARRIER_T @POSIXIPC_SIZEOF_PTHREAD_BARRIER_T@
#define POSIXIPC_SIZEOF_PTHREAD_SPINLOCK_T @POSIXIPC_SIZEOF_PTHREAD_SPINLOCK_T@
#define POSIXIPC_SIZEOF_SEM_T @POSIXIPC_SIZEOF_SEM_T@

#define POSIXIPC_HAVE_PTHREAD_MUTEXATTR_SETROBUST @POSIXIPC_HAVE_PTHREAD_MUTEXATTR_SETROBUST@
#define POSIXIPC_HAVE_PTHREAD_MUTEXATTR_SETPSHARED @POSIXIPC_HAVE_PTHREAD_MUTEXATTR_SETPSHARED@
#define POSIXIPC_HAVE_PTHREAD_MUTEXATTR_SETPROTOCOL @POSIXIPC_HAVE_PTHREAD_MUTEXATTR_SETPROTOCOL@
#define POSIXIPC_HAVE_PTHREAD_RWLOCKATTR_SETPSHARED @POSIXIPC_HAVE_PTHREAD_RWLOCKATTR_SETPSHARED@
#define POSIXIPC_HAVE_PTHREAD_CONDATTR_SETPSHARED @POSIXIPC_HAVE_PTHREAD_CONDATTR_SETPSHARED@
#define POSIXIPC_HAVE_PTHREAD_CONDATTR_SETCLOCK @POSIXIPC_HAVE_PTHREAD_CONDATTR_SETCLOCK@
#define POSIXIPC_HAVE_PTHREAD_BARRIER_WAIT @POSIXIPC_HAVE_PTHREAD_BARRIER_WAIT@
#define POSIXIPC_HAVE_PTHREAD_BARRIERATTR_SETPSHARED @POSIXIPC_HAVE_PTHREAD_BARRIERATTR_SETPSHARED@
#define POSIXIPC_HAVE_PTHREAD_SPIN_INIT @POSIXIPC_HAVE_PTHREAD_SPIN_INIT@
#define POSIXIPC_HAVE_PTHREAD_SPIN_TRYLOCK @POSIXIPC_HAVE_PTHREAD_SPIN_TRYLOCK@
#define POSIXIPC_HAVE_PTHREAD_MUTEX_TIMEDLOCK @POSIXIPC_HAVE_PTHREAD_MUTEX_TIMEDLOCK@
#define POSIXIPC_HAVE_PTHREAD_MUTEX_CLOCKLOCK @POSIXIPC_HAVE_PTHREAD_MUTEX_CLOCKLOCK@
#define POSIXIPC_HAVE_PTHREAD_RWLOCK_CLOCKRDLOCK @POSIXIPC_HAVE_PTHREAD_RWLOCK_CLOCKRDLOCK@
#define POSIXIPC_HAVE_PTHREAD_RWLOCK_CLOCKWRLOCK @POSIXIPC_HAVE_PTHREAD_RWLOCK_CLOCKWRLOCK@
#define POSIXIPC_HAVE_PTHREAD_COND_CLOCKWAIT @POSIXIPC_HAVE_PTHREAD_COND_CLOCKWAIT@
#define POSIXIPC_HAVE_SEM_TIMEDWAIT @POSIXIPC_HAVE_SEM_TIMEDWAIT@
#define POSIXIPC_HAVE_SEM_CLOCKWAIT @POSIXIPC_HAVE_SEM_CLOCKWAIT@
#define POSIXIPC_HAVE_SEM_OPEN @POSIXIPC_HAVE_SEM_OPEN@
#define POSIXIPC_HAVE_SHM_OPEN @POSIXIPC_HAVE_SHM_OPEN@
#define POSIXIPC_HAVE_MQ_OPEN @POSIXIPC_HAVE_MQ_OPEN@
#define POSIXIPC_HAVE_MEMFD_CREATE @POSIXIPC_HAVE_MEMFD_CREATE@
#define POSIXIPC_HAVE_EVENTFD @POSIXIPC_HAVE_EVENTFD@
#define POSIXIPC_HAVE_FUTEX @POSIXIPC_HAVE_FUTEX@

_Static_assert(ATOMIC_INT_LOCK_FREE == 2,
               "header state must be address-free across processes");
_Static_assert(sizeof(pthread_mutex_t) == POSIXIPC_SIZEOF_PTHREAD_MUTEX_T,
               "pthread_mutex_t size drifted from configure");
_Static_assert(sizeof(pthread_rwlock_t) == POSIXIPC_SIZEOF_PTHREAD_RWLOCK_T,
               "pthread_rwlock_t size drifted from configure");
_Static_assert(sizeof(pthread_cond_t) == POSIXIPC_SIZEOF_PTHREAD_COND_T,
               "pthread_cond_t size drifted from configure");
_Static_assert(sizeof(sem_t) == POSIXIPC_SIZEOF_SEM_T,
               "sem_t size drifted from configure");

#if POSIXIPC_HAVE_PTHREAD_BARRIER_WAIT
_Static_assert(sizeof(pthread_barrier_t) == POSIXIPC_SIZEOF_PTHREAD_BARRIER_T,
               "pthread_barrier_t size drifted from configure");
#endif
#if POSIXIPC_HAVE_PTHREAD_SPIN_INIT
_Static_assert(sizeof(pthread_spinlock_t) == POSIXIPC_SIZEOF_PTHREAD_SPINLOCK_T,
               "pthread_spinlock_t size drifted from configure");
#endif

#endif
